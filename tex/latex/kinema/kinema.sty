\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kinema}[2026/10/14 v0.4.0 Browser animations between Beamer overlays]
\RequirePackage{tikz}
\makeatletter
% Each key marks a TikZ scope; kinema-viewer.js animates scopes that share a name on
% consecutive pages. The keys emit SVG only under the dvisvgm driver, which the
% kinema build selects; every other driver ignores them. Under that driver, TikZ
% externalization is off, \includestandalone reads the figure source, and each PDF
% figure is listed in \jobname.knpdf and replaced by the SVG that the build makes
% from it in \knoutdir, because dvisvgm cannot read PDF files on its own.
\def\kn@driver{pgfsys-dvisvgm.def}
\def\kn@keys#1{%
	\tikzset{#1/.style={
				execute at begin scope={\pgfsysprotocol@literal{<g data-kn-#1="##1">}},
				execute at end scope={\pgfsysprotocol@literal{</g>}}}}}
\gdef\kn@transition{}
\newcount\kn@frame
\newcommand{\kntransition}[1]{\gdef\kn@transition{#1}}
\ifx\pgfsysdriver\kn@driver
	\kn@keys{morph}\kn@keys{move}\kn@keys{zoom}\kn@keys{fade}\kn@keys{drawon}
	\tikzset{every picture/.append style={
				execute at begin picture={\pgfsysprotocol@literal{<g data-kn-picture="">}},
				execute at end picture={\pgfsysprotocol@literal{</g>}}}}
	\PassOptionsToPackage{mode=tex}{standalone}
	\RequirePackage{pdftexcmds}
	\providecommand{\knoutdir}{}
	\newwrite\kn@pdflist
	\def\kn@noeps#1{\PackageError{kinema}{The HTML deck cannot show #1.
			Convert it to PDF or SVG}{}}
	\def\kn@cropbox{cropbox}
	\def\kn@nocrop#1#2{\PackageError{kinema}{The HTML deck does not support the
			#2 option of \string\includegraphics\space for #1. Crop the PDF file itself,
			for example with pdfcrop, and remove the option}{}}
	\def\kn@nobox#1{\PackageError{kinema}{The HTML deck shows only the crop box
			of #1. Remove the pagebox option, or make a PDF whose crop box covers the
			area you need}{}}
	\def\kn@pdf#1{%
		\ifGin@bbox\kn@nocrop{#1}{bb, natwidth, or natheight}\fi
		\ifx\Gin@pagebox\kn@cropbox\else\kn@nobox{#1}\fi
		\edef\kn@page{\ifx\Gin@page\@empty 1\else\Gin@page\fi}%
		\edef\kn@file{#1}%
		\ifcsname kn@key@\kn@file:\kn@page\endcsname\else
			\expandafter\xdef\csname kn@key@\kn@file:\kn@page\endcsname{%
				\pdf@mdfivesum{\kn@file:\kn@page:\pdf@filemdfivesum{\kn@file}}}%
			\immediate\write\kn@pdflist{\csname kn@key@\kn@file:\kn@page\endcsname
				\space\kn@page\space\detokenize\expandafter{\kn@file}}%
		\fi
		\edef\kn@svg{\knoutdir kn-\csname kn@key@\kn@file:\kn@page\endcsname.svg}%
		\IfFileExists{\kn@svg}{\kn@pdfassvg}{}}
	\def\kn@minus#1#2#3{\dimen@#2pt\advance\dimen@-#3pt\edef#1{\strip@pt\dimen@}}
	% The SVG covers the whole crop box (\Gin@ollx..\Gin@oury, saved by trim and
	% viewport); \Ginclude@bitmap shows the region \Gin@llx..\Gin@ury of it, in
	% coordinates that start at the lower-left corner of that box.
	\def\kn@pdfassvg{%
		\ifx\Gin@viewport@code\relax
			\let\Gin@ollx\Gin@llx\let\Gin@olly\Gin@lly
			\let\Gin@ourx\Gin@urx\let\Gin@oury\Gin@ury
		\fi
		\kn@minus\Gin@svg@real@width@bp\Gin@ourx\Gin@ollx
		\kn@minus\Gin@svg@real@height@bp\Gin@oury\Gin@olly
		\kn@minus\Gin@llx\Gin@llx\Gin@ollx
		\kn@minus\Gin@urx\Gin@urx\Gin@ollx
		\kn@minus\Gin@lly\Gin@lly\Gin@olly
		\kn@minus\Gin@ury\Gin@ury\Gin@olly
		\Ginclude@bitmap{\kn@svg}}
	\def\kn@readpdf#1{%
		\let\kn@bbox\Gread@BBox
		\edef\Gread@BBox{\@percentchar\@percentchar HiResBoundingBox}%
		\kn@origreadpdf{#1}%
		\let\Gread@BBox\kn@bbox}
	\def\kn@graphics{%
		\ifx\Gread@pdf\kn@readpdf\else\let\kn@origreadpdf\Gread@pdf\fi
		\let\Gread@pdf\kn@readpdf
		\let\Ginclude@pdf\kn@pdf
		\let\Ginclude@eps\kn@noeps
		\def\Gin@extensions{.svg,.pdf,.eps,.png,.jpg,.jpeg}}
	\immediate\openout\kn@pdflist=\jobname.knpdf
	\ifdefined\Ginclude@pdf\kn@graphics\fi
	\AtBeginDocument{%
		\ifdefined\tikzexternaldisable\tikzexternaldisable\fi
		\ifdefined\standaloneconfig\standaloneconfig{mode=tex}\fi
		\kn@graphics}
	% beamerbaseboxes sets the body color of a rounded box into \bmb@colorbox, outside
	% any picture, and unboxes it later inside one. The SVG driver opens a <g> for that
	% color and counts it in \pgf@sys@svg@scopecount, so move the count with the box,
	% or the picture never writes the matching </g>. The rounded cap takes its color from
	% \color, which dvisvgm applies to text only, so the cap must use \pgfsetcolor.
	\def\kn@groups{0}
	\def\kn@roundedboxes{%
		\expandafter\patchcmd\csname\string\beamerboxesrounded\endcsname
		{\pgfsetcolor{lower.bg}}
		{\edef\kn@groups{\the\pgf@sys@svg@scopecount}\pgfsetcolor{lower.bg}%
			\xdef\kn@groups{\the\numexpr\pgf@sys@svg@scopecount-\kn@groups}%
			\global\advance\pgf@sys@svg@scopecount by-\kn@groups\relax}{}{}%
		\expandafter\patchcmd\csname\string\beamerboxesrounded\endcsname
		{\color{lower.bg}}{\pgfsetcolor{lower.bg}}{}{}%
		\expandafter\patchcmd\csname\string\beamerboxesrounded\endcsname
		{\color{upper.bg}}{\pgfsetcolor{upper.bg}}{}{}%
		\patchcmd{\endbeamerboxesrounded}{\unhbox\bmb@colorbox}
		{\unhbox\bmb@colorbox\global\advance\pgf@sys@svg@scopecount by\kn@groups\relax}{}{}}
	\AtBeginDocument{\ifdefined\beamerboxesrounded\kn@roundedboxes\fi}
	\AtBeginEnvironment{frame}{\gdef\kn@transition{}\global\advance\kn@frame by 1 }
	\AddToHook{shipout/foreground}{\put(0,0){\special{dvisvgm:raw
				<g data-kn-frame='\the\kn@frame' data-kn-transition='\kn@transition'/>}}}
\else
	\tikzset{morph/.style={}, move/.style={}, zoom/.style={}, fade/.style={}, drawon/.style={}}
\fi
\makeatother
